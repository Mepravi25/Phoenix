# FastAPI authentication and database. Keep real values in backend/.env or in
# the terminal session; do not commit secrets.
DATABASE_URL=postgresql://postgres:replace-me@127.0.0.1:5432/traffic_command
JWT_SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared MQTT settings. The intersection agent and FastAPI service must use
# exactly the same broker and transport.
MQTT_BROKER=127.0.0.1
MQTT_PORT=1883
MQTT_TRANSPORT=tcp
MQTT_WS_PATH=/mqtt
TRAFFIC_STALE_AFTER_SECONDS=8
TRAFFIC_DEMO_MODE=0

# FCFS emergency-vehicle signal reservations. These values must be compatible
# with the intersection agent's 120-second reservation horizon.
RESERVATION_HORIZON_SECONDS=120
RESERVATION_WINDOW_SECONDS=4
RESERVATION_LEAD_SECONDS=2
RESERVATION_ACK_TIMEOUT_SECONDS=2.5
RESERVATION_ACK_ATTEMPTS=2
RESERVATION_MAX_REROUTES=3
RESERVATION_CONFLICT_DELAY_SECONDS=4

# Browser origin allowed to call FastAPI during local development.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
